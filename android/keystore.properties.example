# Параметры стабильной подписи APK (НЕ коммитьте этот файл с реальными данными).
#
# Скопируйте в android/keystore.properties и заполните значениями своего ключа.
# Файл keystore.properties и каталог android/keystore/ в git не попадают.
# Тот же ключ должен использоваться в GitHub Actions (секреты
# UMBRA_SIGNING_KEYSTORE / UMBRA_SIGNING_KEYSTORE_PASSWORD /
# UMBRA_SIGNING_KEY_ALIAS / UMBRA_SIGNING_KEY_PASSWORD).
#
# ВАЖНО: ключ подписи менять нельзя. Потеря ключа = невозможность обновить
# уже установленное приложение (только удаление и установка заново).

storeFile=keystore/umbra.keystore
storePassword=CHANGE_ME
keyAlias=umbra
keyPassword=CHANGE_ME
