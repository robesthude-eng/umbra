# Пример переменных окружения. Скопируйте в .env и заполните реальными значениями.
# НИКОГДА не коммитьте .env с реальными секретами в git.

# Адрес прослушивания
LISTEN_ADDR=:8080
# Публикуемый адрес порта Docker Compose (по умолчанию только локальный прокси)
BIND_ADDR=127.0.0.1

# Хранилище: "memory" (разработка) или "postgres" (продакшн)
STORE=postgres

# DSN PostgreSQL
DATABASE_URL=postgres://umbra:CHANGE_ME@localhost:5432/umbra?sslmode=disable

# Срок после входа/продления: 30 дней. Старое значение .env нужно обновить вручную.
TOKEN_TTL_SECONDS=2592000
# Совместимость только с username-клиентами без телефона; для Android оставьте false.
ALLOW_LEGACY_AUTH=false
# Прямой запуск за Caddy на этом же хосте. Для Docker укажите точный IP шлюза
# сети контейнера (инструкция в docs/deploy.md). Не доверяйте всей внешней сети.
TRUSTED_PROXIES=127.0.0.1,::1

# Код входа поступает владельцу Umbra в Telegram; он передаёт код пользователю.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=0
# Необязательный релей Telegram (оставьте пустым для прямого Bot API).
TELEGRAM_API_BASE=
TELEGRAM_API_KEY=

# Максимальный размер сообщения, байты (2 MiB)
MAX_MESSAGE_BYTES=2097152

# Директория зашифрованных файлов при локальном запуске.
# Docker Compose использует /data/blobs внутри контейнера и volume blobdata.
BLOB_DIR=./data/blobs

# Максимальный размер зашифрованного файла, байты (50 MiB; без multipart-обвязки)
MAX_MEDIA_BYTES=52428800

# Квота суммарного объёма медиа на пользователя, байты (0 = без лимита)
MAX_USER_MEDIA_BYTES=1073741824

# Хранилище блобов: "file" (по умолчанию) или "s3" (S3/MinIO)
BLOB_STORE_TYPE=file

# Настройки S3/MinIO (при BLOB_STORE_TYPE=s3)
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=umbra-media
S3_REGION=us-east-1
S3_USE_SSL=false

# Настройки PostgreSQL для Docker Compose; задайте свой пароль, например openssl rand -hex 32.
POSTGRES_USER=umbra
POSTGRES_DB=umbra
POSTGRES_PASSWORD=

# Звонки: ICE-серверы, клиент забирает их через GET /v1/turn.
# STUN хватает для домашнего Wi-Fi; TURN нужен, когда оба собеседника
# за «серым» мобильным NAT.
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
# Общий секрет coturn (--use-auth-secret): openssl rand -hex 32.
# Сервер выдаёт по нему временные учётки; в APK пароль не попадает.
TURN_SECRET=
TURN_TTL_SECONDS=3600
# Запасной вариант — постоянная учётка TURN (если секрет не задан).
TURN_USERNAME=
TURN_PASSWORD=
# Для профиля turn в docker compose: домен и внешний IP TURN-сервера.
TURN_REALM=turn.example.com
TURN_PUBLIC_IP=

# ---------- Push-уведомления (Firebase Cloud Messaging) ----------
# Без этого блока сообщения и звонки доходят только при открытом приложении.
# Файл берётся в консоли Firebase: Project settings → Service accounts →
# Generate new private key. Это не google-services.json (тот нужен приложению).
FCM_CREDENTIALS_FILE=
# Альтернатива файлу — тот же JSON одной строкой (удобно в секретах).
FCM_CREDENTIALS_JSON=
# Обычно не нужен: project_id берётся из файла.
FCM_PROJECT_ID=
