# Пример переменных окружения. Скопируйте в .env и заполните реальными значениями.
# НИКОГДА не коммитьте .env с реальными секретами в git.

# Адрес прослушивания
LISTEN_ADDR=:8080
# Публикуемый адрес порта Docker Compose (по умолчанию только локальный прокси)
BIND_ADDR=127.0.0.1

# Хранилище: "memory" (разработка) или "postgres" (продакшн)
STORE=postgres

# DSN PostgreSQL
DATABASE_URL=postgres://umbra:CHANGE_ME@localhost:5432/umbra?sslmode=disable

# Срок жизни сессионного токена, секунды
TOKEN_TTL_SECONDS=86400

# Код входа поступает владельцу Umbra в Telegram; он передаёт код пользователю.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=0
# Необязательный релей Telegram (оставьте пустым для прямого Bot API).
TELEGRAM_API_BASE=
TELEGRAM_API_KEY=

# Максимальный размер сообщения, байты (2 MiB)
MAX_MESSAGE_BYTES=2097152

# Директория зашифрованных файлов при локальном запуске.
# Docker Compose использует /data/blobs внутри контейнера и volume blobdata.
BLOB_DIR=./data/blobs

# Максимальный размер зашифрованного файла, байты (50 MiB; без multipart-обвязки)
MAX_MEDIA_BYTES=52428800

# Квота суммарного объёма медиа на пользователя, байты (0 = без лимита)
MAX_USER_MEDIA_BYTES=1073741824

# Хранилище блобов: "file" (по умолчанию) или "s3" (S3/MinIO)
BLOB_STORE_TYPE=file

# Настройки S3/MinIO (при BLOB_STORE_TYPE=s3)
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=umbra-media
S3_REGION=us-east-1
S3_USE_SSL=false

# Настройки PostgreSQL для Docker Compose; задайте свой пароль, например openssl rand -hex 32.
POSTGRES_USER=umbra
POSTGRES_DB=umbra
POSTGRES_PASSWORD=
