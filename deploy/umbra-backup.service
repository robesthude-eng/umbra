[Unit]
Description=Umbra encrypted PostgreSQL backup

[Service]
Type=oneshot
User=deploy
Group=deploy
EnvironmentFile=/opt/umbra/backup.env
UMask=0077
ExecStart=/usr/local/bin/umbra-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/umbra
TimeoutStartSec=30min
