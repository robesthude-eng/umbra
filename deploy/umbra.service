# systemd-юнит для запуска Umbra напрямую (без Docker).
# Кладётся в /etc/systemd/system/umbra.service
#
# Подготовка (см. docs/deploy.md):
#   useradd --system --home /opt/umbra --shell /usr/sbin/nologin umbra
#   mkdir -p /opt/umbra/data/blobs && chown -R umbra:umbra /opt/umbra/data
#   cp .env.example /opt/umbra/.env  # заполнить секреты; chown root:umbra; chmod 640
[Unit]
Description=Umbra — приватный мессенджер (сервер)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
# Пользователь, под которым запускается (НЕ root)
User=umbra
Group=umbra
WorkingDirectory=/opt/umbra
# Все настройки и секреты — в env-файле (root:umbra, 640)
EnvironmentFile=/opt/umbra/.env
ExecStart=/usr/local/bin/umbra-server

# Перезапуск при сбое
Restart=on-failure
RestartSec=5

# Ограничения безопасности
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/umbra/data

[Install]
WantedBy=multi-user.target
