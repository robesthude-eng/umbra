# systemd-юнит GC осиротевших блобов (oneshot, запускается umbra-gc.timer).
# Кладётся в /etc/systemd/system/umbra-gc.service
#
# Льготный период -min-age: сироты младше 24 ч не удаляются, чтобы не удалить
# blob незавершённой загрузки (blob публикуется раньше метаданных).
# GC требует STORE=postgres: тот же EnvironmentFile, что и у umbra.service.
[Unit]
Description=Umbra — GC осиротевших блобов
After=postgresql.service umbra.service

[Service]
Type=oneshot
User=umbra
Group=umbra
EnvironmentFile=/opt/umbra/.env
ExecStart=/usr/local/bin/umbra-gc -min-age=24h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/umbra/data
